# ============================================================
# WASL — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR

# ── Database ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://wasl_user:CHANGE_ME@localhost:5432/wasl_dev

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 bytes. Rotate every 90 days in production.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS

# ── Field Encryption ─────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used for encrypting national_id_number and tax_id fields at rest.
ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_32_BYTE_FERNET_KEY

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development default shown below; update for staging and production.
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Base URL of the FastAPI backend, as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Monitoring (optional, fill in when configured) ───────────
# SENTRY_DSN=https://...@sentry.io/...
