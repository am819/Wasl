# ============================================================
# WASL — Root Environment Variable Reference
# This file documents ALL variables used across the project.
# See backend/.env.example and frontend/.env.example for
# service-specific copies to use during local development.
# NEVER commit a .env file with real values.
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development       # development | staging | production
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR

# ── Database (backend) ───────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://wasl_user:CHANGE_ME@localhost:5432/wasl_dev

# ── Authentication (backend) ─────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 bytes. Placeholder values are rejected at startup in production.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS

# ── Field Encryption (backend) ───────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used for national_id_number and tax_id at rest.
# Placeholder values are rejected at startup in production.
ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_32_BYTE_FERNET_KEY

# ── CORS (backend) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
# Base URL of the FastAPI backend, as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Monitoring (optional) ────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
