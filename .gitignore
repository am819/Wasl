# ============================================================
# WASL — .gitignore
# ============================================================

# ── Secrets (never commit these) ────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.egg-info/
dist/
build/

# ── Node.js / Next.js ────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── Database ─────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS ───────────────────────────────────────────────────────
Desktop.ini
.Spotlight-V100
.Trashes

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Uploads / static media (not version controlled) ─────────
uploads/
media/
