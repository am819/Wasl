# ============================================================
# WASL Backend — Environment Variables
# Copy to .env: cp .env.example .env
# Fill in real values. NEVER commit .env.
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Database ─────────────────────────────────────────────────
# Local dev: ensure PostgreSQL is running and wasl_dev database exists.
# Create with: psql -U postgres -c "CREATE DATABASE wasl_dev;"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wasl_dev

# ── Authentication ───────────────────────────────────────────
# DEVELOPMENT: placeholder is accepted (app starts normally).
# PRODUCTION: must be a real secret — startup fails if placeholder is used.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_USE

# ── Field Encryption ─────────────────────────────────────────
# DEVELOPMENT: placeholder is accepted.
# PRODUCTION: must be a real Fernet key — startup fails if placeholder is used.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_BEFORE_USE

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
