# ============================================================
# WASL Frontend — Environment Variables
# Copy to .env.local: cp .env.example .env.local
# NEXT_PUBLIC_* variables are safe to expose to the browser.
# NEVER put secrets (JWT keys, DB passwords) in this file.
# ============================================================

# URL of the FastAPI backend API (used by browser fetch calls).
NEXT_PUBLIC_API_URL=http://localhost:8000
